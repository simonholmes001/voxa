// Copy this file to `Debug.local.xcconfig` (git-ignored) and set your own
// backend base URL for local/device testing. Do not commit real values.
//
// Example:
VOXA_API_BASE_URL = https://your-voxa-function-app.azurewebsites.net
VOXA_PRIVACY_POLICY_URL = https://example.com/privacy

// Optional, but required when building to a physical iPhone from Xcode.
// Keep the real value in Debug.local.xcconfig only.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
