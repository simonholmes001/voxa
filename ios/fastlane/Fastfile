default_platform(:ios)

platform :ios do
  desc "Build and upload an internal TestFlight build"
  lane :upload_internal_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    setup_ci
    match(
      type: "appstore",
      readonly: true,
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION")
    )

    project_path = ENV["VOXA_XCODE_PROJECT"]
    workspace_path = ENV["VOXA_XCODE_WORKSPACE"]
    scheme = ENV.fetch("VOXA_XCODE_SCHEME")

    # Version and build number are injected via xcargs so the pbxproj
    # is not mutated in the CI checkout. MARKETING_VERSION comes from
    # the changeset-driven git tag (see .github/workflows/ios-testflight.yml)
    # and is optional — if unset the value in project.yml is used as a
    # fallback. CURRENT_PROJECT_VERSION is the GitHub Actions run number,
    # which is monotonic and guarantees a unique build number per upload.
    build_number = ENV.fetch("VOXA_BUILD_NUMBER")
    marketing_version = ENV["VOXA_MARKETING_VERSION"]

    xcargs_parts = ["CURRENT_PROJECT_VERSION=#{build_number}"]
    xcargs_parts << "MARKETING_VERSION=#{marketing_version}" if marketing_version && !marketing_version.empty?
    xcargs = xcargs_parts.join(" ")

    gym_options = {
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      xcargs: xcargs
    }

    if project_path && !project_path.empty?
      gym_options[:project] = project_path
    elsif workspace_path && !workspace_path.empty?
      gym_options[:workspace] = workspace_path
    else
      UI.user_error!("Set VOXA_XCODE_PROJECT or VOXA_XCODE_WORKSPACE")
    end

    build_app(gym_options)
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
