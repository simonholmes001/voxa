<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Voxa.Domain\Voxa.Domain.csproj" />
    <!--
      Abstractions-only. Adding the interfaces (ILogger<T>) so services can
      emit diagnostic events; the concrete logger is supplied by DI at
      runtime, so this package pulls in no implementation code.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
